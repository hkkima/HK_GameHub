rules_version = '2';

// ★★★ 베팅판 + 주식판 + 게임허브 통합 보안 규칙 ★★★
//   여러 앱이 같은 Firebase 프로젝트(같은 Firestore)를 공유한다. 프로젝트당 규칙은 하나뿐이므로
//   이 파일이 '권위 있는' 통합본이다. 배포 시 이 파일을 쓰면 모든 앱이 함께 동작한다.
//   (HK_Betting/firestore.rules 와 동기화 필요. 이 파일이 그 상위 집합)
//
// ⚠ 다른 레포에서 규칙을 배포하기 전에 이 파일의 HK GameHub 블록을 그쪽에도 옮길 것.
//   옮기지 않으면 배포하는 순간 게임허브의 좋아요가 동작을 멈춘다.
//
// 핵심 불변식: "포인트(users.balance)는 검증된 경로로만 증가한다(인플레 차단)".
//   - 베팅: 참가자는 balance 감소만(베팅), 증가(정산)는 운영자만.
//   - 주식: 모든 거래/배당/시세조정은 Cloud Functions(Admin SDK)가 실행 → 규칙을 우회한다.
//           따라서 클라이언트는 stocks/holdings/ledger/meta(stockBoard) 를 '읽기만' 가능.
//           balance 증가(매도·배당)는 오직 함수만 할 수 있다(클라이언트 직접 증가는 아래서 차단).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email in [
          'jetsomk22@gmail.com'
          // 'another-admin@gmail.com'
        ];
    }

    // ── 공유: 참가자 계정 (이름 + PIN, balance) ──────────────
    match /users/{userId} {
      allow read: if true;                  // 명단/리더보드 공개
      allow delete: if isAdmin();
      // 자체 가입: 본인이 만들되 시작 balance 는 반드시 0.
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.balance == 0
            && request.resource.data.keys().hasOnly(['name', 'pinHash', 'balance']));
      // 운영자는 자유롭게. 참가자(클라이언트)는 balance 만, '감소'만 허용(베팅용).
      //   주식 매도/배당의 balance 증가는 Cloud Functions(Admin SDK)가 처리 → 규칙 우회.
      allow update: if isAdmin()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])
            && request.resource.data.balance is int
            && request.resource.data.balance >= 0
            && request.resource.data.balance < resource.data.balance);
    }

    // ── 베팅: meta(board 등) + markets + bets ───────────────
    match /meta/{docId} {
      // stockBoard 포함 모든 meta 는 공개 읽기. 쓰기는 운영자/함수만.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /markets/{marketId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.status == 'open'
            && request.resource.data.status == 'open'
            && request.resource.data.result == resource.data.result);

      match /bets/{betUserId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.stake is int
          && request.resource.data.stake > 0
          && get(/databases/$(database)/documents/markets/$(marketId)).data.status == 'open'
          && getAfter(/databases/$(database)/documents/users/$(betUserId)).data.balance
             == get(/databases/$(database)/documents/users/$(betUserId)).data.balance - request.resource.data.stake;
        allow update, delete: if isAdmin();
      }
    }

    // ── 주식: 전부 읽기 전용. 쓰기는 Cloud Functions(Admin SDK)만 ─
    //   (Admin SDK 는 규칙을 우회하므로 클라이언트 쓰기를 전면 차단해도 함수는 동작)
    match /stocks/{stockId} {
      allow read: if true;
      allow write: if false;
      // 분봉(series)·일봉(candles) 등 하위 시세 이력도 공개 읽기, 쓰기는 함수만.
      match /{sub=**} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /holdings/{holdingId} {
      allow read: if true;
      allow write: if false;
    }
    // 종목 특성(비공개 태그) — 운영자만 읽기. 뉴스 타겟용이라 학생에겐 숨김. 쓰기는 함수만.
    match /stockTraits/{stockId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // 예약 뉴스 큐 — 운영자만 읽기(게시 전까지 학생에게 숨김). 쓰기는 함수(Admin SDK)만.
    match /scheduledNews/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /trades/{tradeId} {
      allow read: if true;
      allow write: if false;
    }
    match /ledger/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // ── DP 교환소: 전부 읽기 전용, 쓰기는 Cloud Functions(Admin SDK)만 ─
    //   DP는 게임 포인트(users.balance)와 별개 통화. meta/dpExchange 는 위 meta 규칙으로 커버.
    match /dpAccounts/{userId} {
      allow read: if true;
      allow write: if false;
    }
    match /dpGoods/{goodsId} {
      allow read: if true;
      allow write: if false;
    }
    match /dpRedemptions/{redId} {
      allow read: if true;   // 학급 투명성. 민감하면 본인+운영자로 좁힐 수 있음.
      allow write: if false;
    }

    // ── 코딩 문제판 (HK_Judge) ───────────────────────────────
    //   문제 메타/예제는 공개 읽기(학습자가 봄). 채점용 전체 테스트케이스(정답)는
    //   운영자만 읽기(problemTests). 문제 쓰기·제출·보상은 전부 Cloud Functions(Admin SDK).
    //   ★ 이 블록은 HK_Judge/firestore.rules 와 동일해야 함 ★
    match /problems/{problemId} {
      allow read: if true;      // 제목·설명·템플릿·공개 예제
      allow write: if false;    // upsertProblem / deleteProblem 함수만
    }
    match /problemTests/{problemId} {
      allow read: if isAdmin();  // 정답이 담긴 채점 케이스 — 학습자에게 숨김
      allow write: if false;
    }
    match /submissions/{subId} {
      allow read: if true;       // 제출 이력(감사·본인 확인). 쓰기는 함수만.
      allow write: if false;
    }
    // 최초 정답 표식(중복 보상 방지) — 함수만 생성.
    match /solved/{solvedId} {
      allow read: if true;
      allow write: if false;
    }

    // ── 외주 게시판 (HK_Board) ───────────────────────────────
    //   외주(gigs)·봉사(helpRequests) 모두 공개 읽기(학급 투명성).
    //   ★모든 쓰기(등록·지원·계약·에스크로 정산·봉사 지급)는 Cloud Functions(Admin SDK)만★.
    //   에스크로는 gigs/{id}.escrow 필드에 보관 → 클라 직접 쓰기 차단으로 무결성 보장.
    match /gigs/{gigId} {
      allow read: if true;
      allow write: if false;
    }
    match /helpRequests/{helpId} {
      allow read: if true;
      allow write: if false;
    }
    // 작업자 프로필(자기소개·스킬) — 공개 읽기, 쓰기는 setProfile 함수만(PIN 검증).
    match /profiles/{userId} {
      allow read: if true;
      allow write: if false;
    }
    // 테스터 모집(다수 인원) — 공개 읽기, 쓰기는 함수만. 에스크로는 recruits/{id}.escrow.
    match /recruits/{recruitId} {
      allow read: if true;
      allow write: if false;
    }

    // ── 팀 경제(팀 포인트) — ★팀 = 주식★ ─────────────────────────
    //   팀 금고는 stocks/{id}.corpBalance (별도 companies 컬렉션 없음. 상장=팀 생성, 상폐=팀 해산).
    //   stocks 는 위에서 이미 공개읽기·쓰기금지. 원장/주문만 여기서 연다.
    //   전부 공개 읽기(학급 투명성 — CEO 지출을 전원이 감시). 쓰기는 Cloud Functions(Admin SDK)만.
    match /teamLedger/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /corpOrders/{orderId} {
      allow read: if true;
      allow write: if false;
    }

    // ── 홀덤 리그 (holdem-league) ────────────────────────────
    //   게임 상태(좌석·핸드·베팅)는 같은 프로젝트의 Realtime Database 에 있고,
    //   여기 있는 건 '돈' 뿐이다 — 바이인 에스크로(holdemGames/{gid}.escrow)와
    //   개설 시점에 고정된 정산 파라미터(buyIn·payouts).
    //   ★쓰기는 Cloud Functions(holdemCreate/Join/Refund/Settle/Revert/Cancel)만★.
    //   클라가 여기를 못 쓰기 때문에, RTDB 게임 상태를 조작해도 배분 비율과
    //   '누가 실제로 냈는지'는 바꿀 수 없다 → 포인트를 만들어 낼 수 없다.
    match /holdemGames/{gid} {
      allow read: if true;
      allow write: if false;
    }

    // ── 게임 허브 (HK_GameHub) ───────────────────────────────
    //   레포: https://github.com/hkkima/HK_GameHub
    //
    //   수강생이 만든 웹게임을 전시하고 좋아요를 받는 갤러리. 게임 파일 자체는
    //   Cloudflare Pages 에 있고, Firestore 에는 좋아요만 저장한다.
    //
    //   컬렉션에 gamehub_ 접두사를 붙인 이유는 이 Firestore 를 여러 앱이 공유하기
    //   때문이다. 접두사가 없으면 위 users(참가자 계정)에 좋아요 목록을 덮어쓴다.
    //
    //     gamehub_games/{slug}                       : { likeCount, lastBy }
    //     gamehub_games/{slug}/likes/{participantId} : { createdAt, paidIn }  문서 존재 = 좋아요
    //     gamehub_users/{participantId}              : { liked: [...] }       갤러리용 캐시
    //
    //   ★ 신원은 request.auth.uid 가 아니라 users/{participantId} 다 ★
    //   수강생은 익명 로그인 + 클라이언트 PIN 확인 방식이라(다른 학급 앱과 동일),
    //   request.auth.uid 는 브라우저마다 다른 익명 uid 이고 학급 신원이 아니다.
    //   그래서 좋아요는 participantId 로 기록하고, 규칙은 그 id 가 실재하는 참가자인지
    //   users 컬렉션에서 확인한다.
    //
    //   ⚠ 한계: 익명 uid 와 participantId 를 규칙 수준에서 묶을 수 없어, 마음먹으면
    //   콘솔에서 남의 이름으로 좋아요 문서를 만들 수 있다(좋아요=포인트라 인플레
    //   경로다). 카운트 상한은 참가자 수이고 누가 눌렀는지는 남지만, 원천 차단은
    //   아니다. 소규모 신뢰 환경을 전제로 한 선택이다. 원천 차단하려면 PIN 을
    //   서버에서 검증해 커스텀 토큰을 발급하는 함수를 붙이고 uid 로 확인하면 된다.
    //
    //   좋아요 수는 여기서만 Cloud Functions 없이 클라이언트가 직접 올린다. 대신
    //   lastBy 로 지목된 참가자의 좋아요 문서가 실제로 생겼는지(사라졌는지)를
    //   getAfter() 로 대조하므로, 좋아요 문서 없이 숫자만 올릴 수 없다.
    //   좋아요 문서는 참가자당 하나뿐이라 카운트는 등록된 참가자 수를 넘을 수 없다.
    //
    //   지급이 끝난 좋아요(paidIn != null)는 삭제할 수 없다. 포인트를 받은 뒤
    //   좋아요를 취소해 근거를 지우는 것을 막기 위함이다.
    function gh_isParticipant(pid) {
      return exists(/databases/$(database)/documents/users/$(pid));
    }
    function gh_likeRef(slug, pid) {
      return /databases/$(database)/documents/gamehub_games/$(slug)/likes/$(pid);
    }
    function gh_likedAfter(slug)  { return getAfter(gh_likeRef(slug, request.resource.data.lastBy)) != null; }
    function gh_likedBefore(slug) { return exists(gh_likeRef(slug, request.resource.data.lastBy)); }
    function gh_countShape() {
      return request.resource.data.keys().hasOnly(['likeCount', 'lastBy'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.lastBy is string
        && gh_isParticipant(request.resource.data.lastBy);
    }

    match /gamehub_games/{slug} {
      allow read: if true;                       // 좋아요 수는 비로그인도 본다

      // 첫 좋아요: 문서가 없던 게임에 likeCount = 1 로 생성
      allow create: if signedIn()
        && gh_countShape()
        && request.resource.data.likeCount == 1
        && !gh_likedBefore(slug)
        && gh_likedAfter(slug);

      allow update: if signedIn()
        && gh_countShape()
        && (
          // 좋아요 누름: 없던 좋아요가 생기면서 +1
          (request.resource.data.likeCount == resource.data.likeCount + 1
           && !gh_likedBefore(slug) && gh_likedAfter(slug))
          ||
          // 좋아요 취소: 있던 좋아요가 사라지면서 -1
          (request.resource.data.likeCount == resource.data.likeCount - 1
           && gh_likedBefore(slug) && !gh_likedAfter(slug))
        );

      allow delete: if isAdmin();

      // 문서 ID 는 참가자 ID(users 문서 ID)다. 익명 uid 가 아니다.
      // paidIn 은 지급 회차 ID. 생성 시에는 반드시 null 이어야 하고,
      // 값을 채우는 것은 Admin SDK(gamehubPayout)뿐이다.
      match /likes/{participantId} {
        allow read: if true;                     // 누가 눌렀는지 공개 (학급 투명성)

        allow create: if signedIn()
          && gh_isParticipant(participantId)
          && request.resource.data.keys().hasOnly(['createdAt', 'paidIn'])
          && request.resource.data.paidIn == null;

        // 이미 지급된 좋아요는 취소할 수 없다
        allow delete: if signedIn()
          && resource.data.paidIn == null;

        allow update: if false;                  // paidIn 은 함수만 채운다
      }
    }

    // 참가자가 좋아요한 게임 목록 캐시. 갤러리를 열 때 게임 수만큼 읽지 않고
    // 문서 1개로 끝내기 위한 것. 정본은 gamehub_games/{slug}/likes/{participantId} 다.
    match /gamehub_users/{participantId} {
      allow read: if true;
      allow write: if signedIn()
        && gh_isParticipant(participantId)
        && request.resource.data.keys().hasOnly(['liked']);
    }

    // 주간 지급 회차 기록. 학급 투명성을 위해 공개 읽기, 쓰기는 gamehubPayout 만.
    match /gamehub_payouts/{payoutId} {
      allow read: if true;
      allow write: if false;
    }

    // ── 즉시 게시 (단일 HTML) ─────────────────────────────────
    //   수강생이 자체완결 index.html 하나를 올리면 검토·빌드 없이 바로 갤러리에
    //   뜬다. HTML 원문은 content 서브문서에 담고, 갤러리 목록은 메타 문서만 읽어
    //   가볍게 유지한다. 플레이어는 그 HTML 을 iframe srcdoc + sandbox(allow-scripts,
    //   same-origin 없음)로 렌더한다 — 오리진이 없는 샌드박스라 허브와 완전히 격리된다.
    //
    //   소유는 참가자(authorId) 기준이다. 클라이언트가 PIN 으로 로그인해 누구인지
    //   알기 때문에, 기기·재로그인과 무관하게 본인 게임을 알아본다(UI 가 authorId 로
    //   수정·삭제 버튼을 노출한다). by 는 어느 익명 세션에서 올렸는지 남기는 정보일
    //   뿐 소유 판정에는 쓰지 않는다.
    //
    //   ⚠ 규칙 강제의 한계: 규칙은 익명 uid 만 신뢰할 수 있어서 "이 익명 유저가
    //   정말 그 authorId 인가" 를 검증하지 못한다. 그래서 update 는 authorId 를
    //   못 바꾸게(크레딧 보호) 강제할 뿐, 콘솔로 남의 게임 내용을 고치거나 지우는
    //   것까지 막지는 못한다. 좋아요와 같은 신뢰 모델이다. 원천 차단은 PIN 을
    //   서버에서 검증하는 커스텀 토큰(별도 과제)이 있어야 가능하다.
    function gh_instantMetaShape() {
      return request.resource.data.keys().hasOnly(
               ['title', 'author', 'authorId', 'cohort', 'description', 'tags', 'thumb', 'by', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.author is string
        && gh_isParticipant(request.resource.data.authorId)
        && (!('by' in request.resource.data) || request.resource.data.by is string)
        // 썸네일은 있으면 작은 data URI 여야 한다(갤러리가 메타와 함께 읽으므로)
        && (!('thumb' in request.resource.data)
            || (request.resource.data.thumb is string
                && request.resource.data.thumb.size() < 80000));
    }

    match /gamehub_instant/{slug} {
      allow read: if true;

      allow create: if signedIn() && gh_instantMetaShape();
      // authorId 는 못 바꾼다(남이 원저자 크레딧을 뺏지 못하게)
      allow update: if signedIn() && gh_instantMetaShape()
                    && request.resource.data.authorId == resource.data.authorId;
      allow delete: if signedIn();

      // HTML 원문. 플레이할 때만 읽으므로 갤러리 로드에는 포함되지 않는다.
      match /content/{doc} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['html'])
          && request.resource.data.html is string
          && request.resource.data.html.size() < 900000;
        allow delete: if signedIn();
      }
    }
  }
}
